{
  "$schema": "https://doujiao.app/schemas/plugin-manifest.v2.json",
  "id": "object-storage",
  "publisher": "doujiao-official",
  "name": "对象存储管理",
  "version": "1.0.3",
  "changelog": "【v1.0.3】支持与宿主全局配置同步、导入导出实时联动；修复对端关闭连接 (net::ERR_CONNECTION_CLOSED) 网络异常自动直连重试与 HTTP/HTTPS 智能识别",
  "description": "支持 S3 / MinIO / 阿里云 OSS / 腾讯云 COS / Cloudflare R2 等对象存储，支持目录树浏览、文件拖拽上传、预签名分享与多媒体在线预览",
  "icon": "🪣",
  "engines": {
    "doujiao": ">=0.2.0 <0.3.0",
    "pluginApi": "^1.0.0"
  },
  "entrypoints": {
    "ui": "dist/index.html"
  },
  "permissions": [
    {
      "capability": "network.request",
      "hosts": ["*"],
      "methods": ["GET", "POST", "PUT", "DELETE", "HEAD"]
    },
    {
      "capability": "download.enqueue",
      "formats": ["*"]
    }
  ]
}
