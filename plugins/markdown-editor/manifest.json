{
  "$schema": "https://doujiao.app/schemas/plugin-manifest.v2.json",
  "id": "markdown-editor",
  "publisher": "doujiao-official",
  "name": "Markdown 编辑器",
  "version": "1.3.1",
  "description": "高效双栏 Markdown 写作与预览，支持本地时间轴快照、Git 版本控制与 Diff 对照、自定义另存为路径、默认保存目录配置与实时存盘",
  "icon": "📝",
  "engines": {
    "doujiao": ">=0.2.0 <0.3.0",
    "pluginApi": "^1.0.0"
  },
  "entrypoints": {
    "ui": "dist/index.html"
  },
  "permissions": [
    { "capability": "workspace" }
  ]
}